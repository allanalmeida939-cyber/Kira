# Kira - exemplo de configuracao
# Copie para .env e ajuste as chaves reais do seu ambiente.

# Runtime principal
# Nova UI desktop ligada por padrão; use 0/false/off para desligar.
KIRA_UI_ENABLED=1

# LiveKit Provider
# auto = tenta Cloud 1, Cloud 2, Cloud 3 e depois Local
# cloud = tenta somente Cloud e falha se nenhuma Cloud funcionar
# local = usa somente LiveKit local
LIVEKIT_PROVIDER=auto
LIVEKIT_PROVIDER_CHECK_TIMEOUT=4.0

# ============================================================================== 
# LIVEKIT CLOUD - EMAIL 1
# Preencha aqui o e-mail dono desta conta/chave:
# ============================================================================== 
LIVEKIT_CLOUD_1_EMAIL=colocar_email_1_aqui
LIVEKIT_CLOUD_URL_1=
LIVEKIT_CLOUD_API_KEY_1=
LIVEKIT_CLOUD_API_SECRET_1=

# ============================================================================== 
# LIVEKIT CLOUD - EMAIL 2
# ============================================================================== 
LIVEKIT_CLOUD_2_EMAIL=colocar_email_2_aqui
LIVEKIT_CLOUD_URL_2=
LIVEKIT_CLOUD_API_KEY_2=
LIVEKIT_CLOUD_API_SECRET_2=

# ============================================================================== 
# LIVEKIT CLOUD - EMAIL 3
# ============================================================================== 
LIVEKIT_CLOUD_3_EMAIL=colocar_email_3_aqui
LIVEKIT_CLOUD_URL_3=
LIVEKIT_CLOUD_API_KEY_3=
LIVEKIT_CLOUD_API_SECRET_3=

# ============================================================================== 
# LIVEKIT LOCAL - FALLBACK
# ============================================================================== 
LIVEKIT_LOCAL_EMAIL=local_fallback
LIVEKIT_LOCAL_URL=ws://127.0.0.1:7880
LIVEKIT_LOCAL_API_KEY=devkey
LIVEKIT_LOCAL_API_SECRET=secret

# Variaveis legadas mantidas para compatibilidade interna.
# Em runtime, a Kira mapeia o provider escolhido para LIVEKIT_URL/API_KEY/API_SECRET.
LIVEKIT_URL=ws://127.0.0.1:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# ============================================================================== 
# GEMINI VOZ / CONVERSA - EMAILS
# ============================================================================== 
GEMINI_API_KEY_1_EMAIL=colocar_email_1_aqui
GEMINI_1_API_KEY=
GEMINI_API_KEY_2_EMAIL=colocar_email_2_aqui
GEMINI_2_API_KEY=
GEMINI_API_KEY_3_EMAIL=colocar_email_3_aqui
GEMINI_3_API_KEY=
GEMINI_API_KEY_4_EMAIL=colocar_email_4_aqui
GEMINI_4_API_KEY=

# Aliases antigos opcionais para compatibilidade.
GEMINI_API_KEY=
GOOGLE_API_KEY=

# Gemini Realtime / Kira Voice
GEMINI_REALTIME_VOICE=Kore
GEMINI_REALTIME_TEMPERATURE=0.6
GEMINI_REALTIME_MODEL=
# Compressao da janela de contexto do Gemini Live (1 ativa; 0 desativa)
KIRA_GEMINI_CONTEXT_COMPRESSION=1

# ============================================================================== 
# BROWSER / NAVEGADOR - EMAILS
# Usadas somente pelo browser-use/Chromium headless.
# ============================================================================== 
GEMINI_BROWSER_API_KEY_1_EMAIL=colocar_email_1_aqui
GEMINI_BROWSER_API_KEY_1=
GEMINI_BROWSER_API_KEY_2_EMAIL=colocar_email_2_aqui
GEMINI_BROWSER_API_KEY_2=
GEMINI_BROWSER_API_KEY_3_EMAIL=colocar_email_3_aqui
GEMINI_BROWSER_API_KEY_3=
GEMINI_BROWSER_API_KEY_4_EMAIL=colocar_email_4_aqui
GEMINI_BROWSER_API_KEY_4=
GEMINI_BROWSER_MODEL=gemini-2.5-flash

# Memory Provider
# auto = tenta Mem0, depois local, depois none
# mem0 = tenta somente Mem0; se falhar, cai para none sem bloquear voz
# local = usa somente memoria local; se falhar, cai para none
# none = desativa memoria
KIRA_MEMORY_PROVIDER=auto

# Mem0
MEM0_API_KEY=
MEM0_USER_ID=kira_user

# Memory behavior
KIRA_MEMORY_REQUIRED=false
KIRA_MEMORY_LOAD_TIMEOUT=3
KIRA_MEMORY_SAVE_ENABLED=true
KIRA_MEMORY_STATUS_VISIBLE=true

# Local memory fallback
KIRA_LOCAL_MEMORY_DIR=configs/memory
KIRA_LOCAL_MEMORY_FILE=configs/memory/kira_memory.json

# Sistema de Visao
# Modo desligado por padrao para nao impactar a voz sem intencao do usuario.
ENABLE_VISION_MODE=false

# Monitor usado pelo DXcam. Em setups multi-monitor, ajuste para 0, 1, 2...
SCREEN_CAPTURE_MONITOR_ID=0

# FPS alvo da captura em background. O frame fica em cache para resposta rapida.
SCREEN_CAPTURE_TARGET_FPS=30

# API local do OmniParser para mapear elementos da tela.
OMNIPARSER_API_URL=http://localhost:5000/parse
OMNIPARSER_ENABLED=true

# Controle real de mouse/teclado.
ACTION_CONTROLLER_ENABLED=true
ACTION_CONTROLLER_SAFETY_PAUSE=0.1
VISION_AUTO_SHUTDOWN_MINUTES=10
VISION_AUTO_SHUTDOWN_CHECK_INTERVAL=60
VISUAL_CACHE_TTL_SECONDS=300

# Voz - estabilidade
VOICE_WATCHDOG_SPEAKING_TIMEOUT=120.0
GENERATION_TIMEOUT_S=30.0

KIRA_LOG_ROOT=
KIRA_LOG_KEEP_RECENT=3
KIRA_LOG_LEVEL=INFO
KIRA_LOG_JSONL=true
KIRA_LOG_MAX_FILE_MB=20
KIRA_LOG_REDACT_SECRETS=true
KIRA_LOG_CLEAR_OLD_ON_START=false
KIRA_LOG_FULL_MANUS_PROMPTS=false

# Manus AI
MANUS_ENABLED=false
MANUS_BASE_URL=https://api.manus.ai
MANUS_API_KEY=
MANUS_API_MODE=v2_task_create
MANUS_API_KEY_1=
MANUS_API_KEY_2=
MANUS_API_KEY_3=
MANUS_API_KEY_4=
MANUS_API_KEY_5=
MANUS_DEFAULT_AGENT_PROFILE=
MANUS_OUTPUT_ROOT=
MANUS_TASK_TIMEOUT_MINUTES=45
MANUS_TIMEOUT_SECONDS=180
MANUS_POLL_INTERVAL_SECONDS=8
MANUS_MAX_RETRIES=5
MANUS_KEY_STRATEGY=fallback
MANUS_SHUTDOWN_AFTER_TASK=true
MANUS_SAVE_TO_DEFAULT_FOLDER=true
MANUS_RESET_KEY_STATE_ON_START=true
MANUS_RETRY_AUTH_FAILED_KEYS=false
MANUS_LOG_HTTP=false
KIRA_ALLOW_LOCAL_ARTIFACT_FALLBACK=false

# Browser Runtime
BROWSER_HEADLESS=true
BROWSER_VIEWPORT_WIDTH=1366
BROWSER_VIEWPORT_HEIGHT=768
BROWSER_IDLE_SHUTDOWN_SECONDS=300
BROWSER_VIEW_MAX_FPS=2
BROWSER_VIEW_JPEG_QUALITY=70
BROWSER_PROFILE_DIR=runtime/browser_profile/kira_browser

# WhatsApp
WHATSAPP_ENABLED=true
WHATSAPP_AUTOSTART=false
WHATSAPP_IDLE_SHUTDOWN_SECONDS=300
WHATSAPP_REQUIRE_CONFIRMATION_BEFORE_SEND=true
WHATSAPP_SECRETARY_MODE=false
WHATSAPP_PROFILE_DIR=configs/whatsapp_profile

# Music
MUSIC_ENABLED=true
MUSIC_AUTOSTART=false
MUSIC_IDLE_SHUTDOWN_SECONDS=300
MUSIC_START_ON_TAB_OPEN=true
MUSIC_STOP_WHEN_NOT_PLAYING=true
MUSIC_SHUTDOWN_WHEN_TAB_CLOSED=true

# System Vitals
SYSTEM_VITALS_ENABLED=true
SYSTEM_VITALS_AUTOSTART=false
SYSTEM_VITALS_POLL_ONLY_WHEN_VISIBLE=true
SYSTEM_VITALS_POLL_INTERVAL_SECONDS=2
SYSTEM_VITALS_IDLE_SHUTDOWN_SECONDS=30
SYSTEM_VITALS_LIGHT_STATUS_WITHOUT_COLLECTION=true

# ==============================================================================
# OPCIONAIS (a Kira funciona sem; cada uma liga um recurso a mais)
# ==============================================================================
# Vídeos do YouTube nos painéis (Google Cloud > YouTube Data API v3)
YOUTUBE_API_KEY=
# Olho de Deus: fotos/dados da NASA (api.nasa.gov; sem chave usa DEMO_KEY, com limite)
NASA_API_KEY=
# Olho de Deus: navios em tempo real (aisstream.io)
AISSTREAM_KEY=
