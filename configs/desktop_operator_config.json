{
  "enabled": true,
  "emergency_hotkey": "ctrl+alt+k",
  "emergency_single_key": null,
  "emergency_single_key_hold_seconds": 3.0,
  "capture_backend": "mss",
  "allow_dxcam": false,
  "allow_cv2_processing": true,
  "max_steps_per_task": 50,
  "step_delay_ms": 200,
  "direct_mode_step_delay_ms": 80,
  "require_user_confirmation_on_send": true,
  "require_confirmation_before_submit": true,
  "require_confirmation_before_payment": true,
  "require_confirmation_before_delete": true,
  "cloud_browser_phrase": "navegador na nuvem",
  "gemini_vision_model": "gemini-2.0-flash",
  "gemini_vision_fallback_models": [
    "gemini-1.5-flash",
    "gemini-1.5-flash-8b",
    "gemini-1.5-pro"
  ],
  "vision_rate_limit_cooldown_seconds": 60.0,
  "direct_mode_enabled": true,
  "direct_mode_first": true,
  "vision_for_simple_tasks": false,
  "max_direct_task_captures": 2,
  "max_visual_calls_per_task": 3,
  "max_visual_analyze_calls_per_task": 3,
  "max_visual_verify_calls_per_task": 3,
  "vision_fallback_on_direct_failure": true,
  "copy_selected_only_by_default": true,
  "direct_verify_enabled": true,
  "direct_verify_with_screenshot": false,
  "human_typing_enabled": true,
  "typing_mode": "human",
  "human_typing_min_delay_ms": 18,
  "human_typing_max_delay_ms": 55,
  "human_typing_space_delay_ms": 25,
  "human_typing_newline_delay_ms": 120,
  "human_typing_punctuation_delay_ms": 80,
  "human_typing_chunk_pause_every_chars": 120,
  "human_typing_chunk_pause_ms": 250,
  "human_typing_use_clipboard_for_unicode_chars": true,
  "instant_paste_only_when_user_requests": true,
  "requires_livekit_vision": true,
  "use_livekit_vision_as_primary_source": true,
  "allow_mss_fallback_without_vision": false,
  "pc_operator_requires_active_monitor": true,
  "livekit_vision_max_frame_age_ms": 5000,
  "max_livekit_frame_age_ms": 5000,
  "temp_captures_dir": "logs/pc_operator_captures",
  "keep_captures_last_n": 10,
  "monitor_context_cache_path": "configs/monitor_context_cache.json",
  "visual_cache_ttl_seconds": 60,
  "monitor_labels_persistent": true,
  "voice_narration_enabled": true,
  "pc_operator_pre_action_ack_enabled": false,
  "pc_operator_final_ack_after_completion": true,
  "last_target_ttl_seconds": 300,
  "replace_retry_on_visual_mismatch": true,
  "replace_retry_max_attempts": 1,
  "vision_stop_debounce_seconds": 3.0,
  "vision_status_failure_tolerance": 5,
  "vision_frame_stale_ms": 5000,
  "vision_keep_alive_on_recent_frame": true,
  "pc_operator_verify_new_frame_timeout_seconds": 1.5,
  "task_log_enabled": true,
  "log_level": "INFO"
}
